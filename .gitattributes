* text=auto eol=lf

# Windows 脚本保留 CRLF；其余文本统一 LF，避免 Docker entrypoint 出现 。
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.db binary
*.zip binary
*.bundle binary
